(function () {
    'use strict';

    var ID = 'lampa_ptbr_capas_v2';

    if (window[ID]) return;
    window[ID] = true;

    function iniciar() {
        if (!window.Lampa) return;

        var css = `
            .ptbr-capas-badge {
                position: absolute;
                left: 5px;
                top: 5px;
                z-index: 9999;
                background: #159447;
                color: #fff;
                padding: 4px 7px;
                border-radius: 4px;
                font-size: 11px;
                font-weight: bold;
                pointer-events: none;
            }
            .card {
                position: relative;
            }
        `;

        if (!document.getElementById('ptbr-capas-style')) {
            var style = document.createElement('style');
            style.id = 'ptbr-capas-style';
            style.textContent = css;
            document.head.appendChild(style);
        }

        function verificar() {
            var cards = document.querySelectorAll('.card');

            cards.forEach(function (card) {
                if (card.querySelector('.ptbr-capas-badge')) return;

                var texto = (
                    card.innerText ||
                    card.textContent ||
                    ''
                ).toLowerCase();

                var imagens = card.querySelectorAll('img');

                imagens.forEach(function (img) {
                    texto += ' ' + (img.alt || '');
                    texto += ' ' + (img.title || '');
                });

                if (
                    /pt[- ]?br|portugu[eê]s brasileiro|dublado em portugu[eê]s|dual audio|dual áudio|\bpob\b/.test(texto)
                ) {
                    var badge = document.createElement('div');
                    badge.className = 'ptbr-capas-badge';
                    badge.textContent = 'ÁUDIO PT-BR';
                    card.appendChild(badge);
                }
            });
        }

        verificar();

        if (window.MutationObserver) {
            var observer = new MutationObserver(verificar);
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        }

        console.log('[PT-BR Capas] Plugin iniciado');
    }

    if (window.appready) {
        iniciar();
    } else if (window.Lampa && Lampa.Listener) {
        Lampa.Listener.follow('app', function (e) {
            if (e.type === 'ready') iniciar();
        });
    }
})();
